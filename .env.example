# Storage Configuration
STORAGE_PROVIDER=s3
STORAGE_BUCKET=vod-streaming-upload-151803906541-us-east-2-dev
NEXT_PUBLIC_STORAGE_DIRECT_UPLOAD_ENABLED=true
STORAGE_ENCRYPTION_ENABLED=false
STORAGE_ENCRYPTION_MODE=AES256
STORAGE_CHECKSUM_ALGORITHM=SHA256
STORAGE_SIGNED_URL_TTL_SECONDS=3600
UPLOAD_CHUNK_SIZE_BYTES=104857600
# REQUIRED on AWS: prefixes object keys with raw/ so they match the EventBridge
# `raw/` filter that triggers the S3 -> ingest webhook (upload stage 3) and the
# S3 -> Batch transcode job. Leave unset (false) for local MinIO.
UPLOAD_RAW_PREFIX_ENABLED=false
# Maximum upload file size in GB (default 5). Set both vars to the same value;
# the server enforces UPLOAD_MAX_FILE_SIZE_GB and the browser bundle reads the
# NEXT_PUBLIC_ copy. Example: raise to 10GB by setting both to 10.
UPLOAD_MAX_FILE_SIZE_GB=10
NEXT_PUBLIC_UPLOAD_MAX_FILE_SIZE_GB=10

# MinIO Configuration (for local testing)
MINIO_ENDPOINT=http://localhost:9000
# Browser-reachable base for object URLs (thumbnails). In Docker, MINIO_ENDPOINT
# points at the internal `minio` host; this must stay host-reachable (localhost).
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# AWS S3 Configuration (for production)
# AWS_REGION=us-east-2
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# Application Configuration
NODE_ENV=development
PORT=3000
NEXTAUTH_SECRET=change-me-in-production
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
ADMIN_EMAILS=admin@example.com,owner@example.com
# E2E auth — server-only, never use NEXT_PUBLIC_ prefix
E2E_AUTH_ENABLED=0
E2E_ADMIN_EMAIL=admin-e2e@example.com
NEXT_PUBLIC_E2E_AUTH_ENABLED=0
NEXT_PUBLIC_E2E_ADMIN_EMAIL=admin-e2e@example.com

# S3 host for download SSRF allowlist (e.g. your-bucket.s3.us-east-2.amazonaws.com)
S3_BUCKET_HOST=

# Event Gateway Configuration
# Local: http://localhost:8080/api/v1
# Production on Vercel: https://<function-id>.lambda-url.<region>.on.aws
EVENT_GATEWAY_URL=http://localhost:8080/api/v1
INGEST_PERSISTENCE_BASE_URL=http://localhost:8080/api/v1
INGEST_STORAGE_WEBHOOK_BASE_URL=http://localhost:8080/api/v1
